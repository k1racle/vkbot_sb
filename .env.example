# Для обновления сохраните действующие VK_* до первого запуска новой версии.
# Они импортируются один раз. Дальше группы и ключи задаются в /projects.
# Для чистой установки можно оставить VK_GROUP_ID=0 и остальные VK_* пустыми.
VK_API_VERSION=5.199
VK_GROUP_ID=0
VK_GROUP_TOKEN=put_group_token_here
VK_CALLBACK_SECRET=change_this_secret
VK_CONFIRMATION_CODE=put_vk_confirmation_code_here
# Не меняйте ключ после создания проектов. Пусто — сгенерировать data/projects.key.
# Сохраняйте ключ/файл вместе с резервной копией базы, но вне Git.
PROJECTS_ENCRYPTION_KEY=
PROJECTS_KEY_FILE=data/projects.key
# Публичный адрес панели: нужен для правильной HTTPS-ссылки Callback за nginx.
PUBLIC_BASE_URL=https://vkbot.it-sarkisian.ru
DATABASE_URL=postgresql+psycopg://vkbot:change_this_database_password@postgres:5432/vkbot
PROMO_CODE=SARKISIAN10
SHOP_URL=https://example.com
PROMO_ATTACHMENTS=
MIN_COMMENT_LENGTH=1
STOP_WORDS=
ONE_PROMO_PER_USER=true
TEST_MODE=false
TEST_TRIGGER_PHRASE=тестовое сообщение
ADMIN_TEST_USER_ID=
CHAT_ENABLED=true
# Очередь рассылок и обновление профилей. Отключать только при локальных проверках.
BACKGROUND_JOBS_ENABLED=true
CHAT_GREETING=Привет! Я бот магазина. Напишите, чем помочь.
# ID менеджеров через запятую. Можно задать в админке, раздел «Общение».
OPERATOR_USER_ID=
OPERATOR_TRIGGER_WORDS=оператор,менеджер,человек
OPERATOR_ACK=Передал запрос менеджеру. Скоро с вами свяжутся.
PROMO_MESSAGE=Спасибо за комментарий! 🎁\n\nВаш промокод на скидку: {promo_code}\n\nМагазин: {shop_url}
# Пусто — все посты; либо список ID через запятую: 12345,67890
ALLOWED_POST_IDS=
LOG_LEVEL=INFO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string
POSTGRES_USER=vkbot
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_DB=vkbot
